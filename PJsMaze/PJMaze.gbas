//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//
//                                                                      //
// Project: Random Maze Generator Function for GLBasic                  //
//          Pathfinding Function for GLBasic                            //
//                                                                      //
//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//\\//

SETSCREEN 640,480,1

GLOBAL maze[], pjcos[], pjsin[]

GLOBAL mazex=159 // maze dimensions
GLOBAL mazey=119

GLOBAL startx=1  // start point in passage
GLOBAL starty=117

GLOBAL endx=156  // end point in wall
GLOBAL endy=2

DIM maze[0][0]
DIM pjcos[4]
DIM pjsin[4]

LOCAL loop,loop1,time1,time2,time3

WHILE TRUE

	REDIM maze[0][0] ; REDIM maze[mazex][mazey]	// Reset maze

	time1 = GETTIMERALL()
	MakeMaze(maze[],1) // Maze (maze[] must be DIMed), exact=1, not exact=0
	time2 = GETTIMERALL()
	SolveMaze(maze[])
	time3 = GETTIMERALL()

	FOR loop=0 TO mazex-1
		FOR loop1=0 TO mazey-1
			SELECT maze[loop][loop1]
				CASE 1 // yellow path (solution)
					DRAWRECT 4+(loop*4),4+(loop1*4),4,4,RGB(160,160,0)
				CASE 2 // red walls
					DRAWRECT 4+(loop*4),4+(loop1*4),4,4,RGB(200,0,0)
			ENDSELECT
		NEXT
	NEXT

	DRAWRECT 4+(startx*4),4+(starty*4),4,4,RGB(0,200,0) // green start point
	DRAWRECT 4+(endx*4),4+(endy*4),4,4,RGB(40,40,240) // blue end point

	ALPHAMODE -0.75
	DRAWRECT 0,0,260,45,RGB(0,0,0)
	ALPHAMODE 0
	PRINT "Generated in "+INTEGER(time2-time1)+" milliseconds",10,10
	PRINT "Solved in "+INTEGER(time3-time2)+" milliseconds",10,20
	PRINT "Mouse to Regenerate, Esc Quits",10,30

	SHOWSCREEN

	MOUSEWAIT
WEND

END

// -------------------------------------------------------------------- //

FUNCTION MakeMaze: pjmaze[], pjexact

	LOCAL pjmx = BOUNDS(pjmaze[],0)-1
	LOCAL pjmy = BOUNDS(pjmaze[],1)-1
	LOCAL pjfx,pjfy,pjloop,pjypos,pjxpos,pjfarx,pjfary,pjallx,pjally,pjalldir
	LOCAL pjgo,pjtemp,pjx,pjy,pjdir,pjresult,pjlop,pjx2,pjy2,pjtemp2

	pjcos[0]=1
	pjcos[2]=-1
	pjsin[1]=1
	pjsin[3]=-1

	FOR pjfx=0 TO pjmx
		pjmaze[pjfx][0]=2
		pjmaze[pjfx][pjmy]=2
	NEXT

	FOR pjfy=0 TO pjmy
		pjmaze[0][pjfy]=2
		pjmaze[pjmx][pjfy]=2
	NEXT

	FOR pjloop=1 TO pjmy/6
		pjypos=RND((pjmy-6)/2)*2
		pjxpos=RND(2)*2
		FOR pjfx=1 TO pjxpos
			pjmaze[pjfx][pjypos]=2
		NEXT
		pjypos=RND((pjmy-6)/2)*2
		pjxpos=pjmx-(RND(2)*2)
		FOR pjfx=pjmx TO pjxpos STEP -1
			pjmaze[pjfx][pjypos]=2
		NEXT
	NEXT
	FOR pjloop=1 TO pjmx/6
		pjxpos=4+RND((pjmx-8)/2)*2
		pjmaze[pjxpos][pjmy-1]=2
		pjmaze[pjxpos][pjmy-2]=2
	NEXT

	pjfarx=pjmx
	pjfary=pjmy
	pjallx=0
	pjally=0
	pjexact=pjexact+1

	WHILE TRUE
		WHILE TRUE

			pjallx=pjallx+pjcos[pjalldir]*pjexact
			pjally=pjally+pjsin[pjalldir]*pjexact
			pjgo=pjgo+pjexact

			IF pjgo>=pjfarx-pjexact AND (pjalldir=0 OR pjalldir=2)
				pjgo=0
				pjfarx=pjfarx-pjexact
				pjtemp=pjalldir+1
				pjalldir=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)
			ENDIF
			IF pjgo>=pjfary-pjexact AND (pjalldir=1 OR pjalldir=3)
				pjgo=0
				pjfary=pjfary-pjexact
				pjtemp=pjalldir+1
				pjalldir=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)
			ENDIF

			IF pjfarx<=0 OR pjfary<=0 THEN BREAK
			IF pjmaze[pjallx][pjally]=2 AND (pjallx<pjmx-1 OR pjally<pjmy-1) THEN BREAK

		WEND

		IF pjfarx<=0 OR pjfary<=0 THEN BREAK
		IF pjallx>=pjmx OR pjally>=pjmy THEN BREAK

		pjx=pjallx
		pjy=pjally
		pjdir=RND(3)

		WHILE TRUE

			FOR pjloop=0 TO 3
				pjresult=1
				FOR pjlop=1 TO pjexact+1
					pjx2=pjx+pjcos[pjloop]*pjlop
					pjy2=pjy+pjsin[pjloop]*pjlop
					IF pjx2<=0 OR pjy2<=0 OR pjx2>pjmx OR pjy2>pjmy THEN pjresult=0
					IF pjresult=1
						IF pjmaze[pjx2][pjy2]=2 THEN pjresult=0
					ENDIF
					IF pjresult=1
						pjtemp=pjloop+1
						pjtemp2=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)
						IF pjmaze[pjx2+pjcos[pjtemp2]][pjy2+pjsin[pjtemp2]]=2 THEN pjresult=0
					ENDIF
					IF pjresult=1
						pjtemp=pjloop-1
						pjtemp2=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)
						IF pjmaze[pjx2+pjcos[pjtemp2]][pjy2+pjsin[pjtemp2]]=2 THEN pjresult=0
					ENDIF
				NEXT
				IF pjresult=1 THEN BREAK
			NEXT

			IF pjloop=4 THEN BREAK

			pjtemp=pjdir+1-RND(2)
			pjdir=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)

			pjresult=1
			FOR pjlop=1 TO pjexact+1
				pjx2=pjx+pjcos[pjdir]*pjlop
				pjy2=pjy+pjsin[pjdir]*pjlop
				IF pjx2<=0 OR pjy2<=0 OR pjx2>pjmx OR pjy2>pjmy THEN pjresult=0
				IF pjresult=1
					IF pjmaze[pjx2][pjy2]=2 THEN pjresult=0
				ENDIF
				IF pjresult=1
					pjtemp=pjdir+1
					pjtemp2=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)
					IF pjmaze[pjx2+pjcos[pjtemp2]][pjy2+pjsin[pjtemp2]]=2 THEN pjresult=0
				ENDIF
				IF pjresult=1
					pjtemp=pjdir-1
					pjtemp2=pjtemp-4*(pjtemp>3)+4*(pjtemp<0)
					IF pjmaze[pjx2+pjcos[pjtemp2]][pjy2+pjsin[pjtemp2]]=2 THEN pjresult=0
				ENDIF
			NEXT

			IF pjresult=1
				FOR pjloop=1 TO pjexact
					pjx=pjx+pjcos[pjdir]
					pjy=pjy+pjsin[pjdir]
					pjmaze[pjx][pjy]=2
				NEXT
			ENDIF
		WEND
	WEND

	IF pjexact=2
		FOR pjfx=2 TO pjmx-2 STEP 2
			IF pjmaze[pjfx][2]=0
				pjmaze[pjfx][2]=2 ; pjmaze[pjfx][1]=2
			ENDIF
			IF pjmaze[pjfx][pjmy-2]=0
				pjmaze[pjfx][pjmy-2]=2 ; pjmaze[pjfx][pjmy-1]=2
			ENDIF
		NEXT
		FOR pjfy=2 TO pjmy-2 STEP 2
			IF pjmaze[2][pjfy]=0
				pjmaze[2][pjfy]=2 ; pjmaze[1][pjfy]=2
			ENDIF
			IF pjmaze[pjmx-2][pjfy]=0
				pjmaze[pjmx-2][pjfy]=2 ; pjmaze[pjmx-1][pjfy]=2
			ENDIF
		NEXT
	ENDIF

ENDFUNCTION

FUNCTION SolveMaze: pjmaze[]

	// A* pathfinding from (startx,starty) to (endx,endy)
	// Walls = 2, passages = 0, solution marked as 1
	// 4-directional movement, Manhattan distance heuristic

	LOCAL endpoint = pjmaze[endx][endy]
	pjmaze[endx][endy] = 0  // Blank end position

	LOCAL pjmx = BOUNDS(pjmaze[], 0)
	LOCAL pjmy = BOUNDS(pjmaze[], 1)

	// Per-cell score and parent arrays, indexed [x][y]
	LOCAL asg[]       ; DIM asg[pjmx][pjmy]        // g: cost from start
	LOCAL asf[]       ; DIM asf[pjmx][pjmy]         // f: g + heuristic
	LOCAL aspx[]      ; DIM aspx[pjmx][pjmy]        // parent x (-1 = none)
	LOCAL aspy[]      ; DIM aspy[pjmx][pjmy]        // parent y (-1 = none)
	LOCAL asinopen[]  ; DIM asinopen[pjmx][pjmy]    // 1 = currently in open list
	LOCAL asinclosed[]; DIM asinclosed[pjmx][pjmy]  // 1 = already evaluated

	// Open list stored as parallel flat arrays of x,y coordinates
	LOCAL asopenx[] ; DIM asopenx[pjmx * pjmy]
	LOCAL asopeny[] ; DIM asopeny[pjmx * pjmy]
	LOCAL asopencount = 0

	// Initialise all cells to large cost, no parent
	LOCAL ix, iy
	FOR ix = 0 TO pjmx - 1
		FOR iy = 0 TO pjmy - 1
			asg[ix][iy]        = 999999
			asf[ix][iy]        = 999999
			aspx[ix][iy]       = -1
			aspy[ix][iy]       = -1
			asinopen[ix][iy]   = 0
			asinclosed[ix][iy] = 0
		NEXT
	NEXT

	// Add start node to open list
	asg[startx][starty]      = 0
	asf[startx][starty]      = ABS(endx - startx) + ABS(endy - starty)
	asinopen[startx][starty] = 1
	asopenx[0]               = startx
	asopeny[0]               = starty
	asopencount              = 1

	// 4 directions: right, down, left, up
	LOCAL asdx[] ; DIM asdx[4]
	LOCAL asdy[] ; DIM asdy[4]
	asdx[0] =  1 ; asdy[0] =  0
	asdx[1] =  0 ; asdy[1] =  1
	asdx[2] = -1 ; asdy[2] =  0
	asdx[3] =  0 ; asdy[3] = -1

	LOCAL asfound = FALSE

	WHILE asopencount > 0 AND asfound = FALSE

		// Pick the open node with the lowest f score
		LOCAL asbestf   = 999999
		LOCAL asbestidx = 0
		LOCAL asloop
		FOR asloop = 0 TO asopencount - 1
			LOCAL aslx = asopenx[asloop]
			LOCAL asly = asopeny[asloop]
			IF asf[aslx][asly] < asbestf
				asbestf   = asf[aslx][asly]
				asbestidx = asloop
			ENDIF
		NEXT

		LOCAL ascx = asopenx[asbestidx]
		LOCAL ascy = asopeny[asbestidx]

		// Reached the goal?
		IF ascx = endx AND ascy = endy
			asfound = TRUE
			BREAK
		ENDIF

		// Move this node from open to closed
		asinopen[ascx][ascy]   = 0
		asinclosed[ascx][ascy] = 1

		// Swap with last entry to remove from open list
		asopenx[asbestidx] = asopenx[asopencount - 1]
		asopeny[asbestidx] = asopeny[asopencount - 1]
		asopencount        = asopencount - 1

		// Check each of the 4 neighbours
		LOCAL asdir
		FOR asdir = 0 TO 3

			LOCAL asnx = ascx + asdx[asdir]
			LOCAL asny = ascy + asdy[asdir]

			// Bounds check
			IF asnx < 0 OR asnx >= pjmx OR asny < 0 OR asny >= pjmy THEN CONTINUE

			// Skip walls (value=2) and already-evaluated nodes
			IF pjmaze[asnx][asny] = 2     THEN CONTINUE
			IF asinclosed[asnx][asny] = 1 THEN CONTINUE

			// Cost to reach this neighbour via current node
			LOCAL astentg = asg[ascx][ascy] + 1

			IF astentg < asg[asnx][asny]
				// Better path found - record it
				aspx[asnx][asny] = ascx
				aspy[asnx][asny] = ascy
				asg[asnx][asny]  = astentg
				asf[asnx][asny]  = astentg + ABS(endx - asnx) + ABS(endy - asny)

				// Add to open list if not already there
				IF asinopen[asnx][asny] = 0
					asopenx[asopencount] = asnx
					asopeny[asopencount] = asny
					asopencount          = asopencount + 1
					asinopen[asnx][asny] = 1
				ENDIF
			ENDIF

		NEXT

	WEND

	// Walk back through parent pointers, marking solution cells as 1
	IF asfound = TRUE
		LOCAL astx = endx
		LOCAL asty = endy
		WHILE astx <> -1 AND asty <> -1
			pjmaze[astx][asty] = 1
			LOCAL asnextx = aspx[astx][asty]
			LOCAL asnexty = aspy[astx][asty]
			astx = asnextx
			asty = asnexty
		WEND
	ENDIF

	pjmaze[endx][endy] = endpoint // Reset endpoint

ENDFUNCTION







